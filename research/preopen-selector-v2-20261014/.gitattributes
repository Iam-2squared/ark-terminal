# Keep computation and manifest bytes identical on Windows and Linux.
# V2 code hashes include raw Python bytes; Git-for-Windows CRLF is not allowed.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.lock text eol=lf
*.gz -text
*.zip -text
